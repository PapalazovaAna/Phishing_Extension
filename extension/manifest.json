{
  "manifest_version": 3,
  "name": "Phishing Risk Detector",
  "version": "0.2.0",
  "description": "Detects potentially malicious webpages using URL, reputation, machine learning and DOM analysis.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "icons": {}
}